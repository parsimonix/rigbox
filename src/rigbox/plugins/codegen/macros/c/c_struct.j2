{% macro c_struct(context) %}
typedef {{ '__packed struct' if context.packed else 'struct' }}
{
{% for field_name, field_type_and_desc in context.fields.items() %}
    {{ field_type_and_desc[0] }} {{field_name}}; // {{ field_type_and_desc[1] }}
{% endfor %}
} {{ context.struct_name.rstrip("_t") | lower }}_t;
{% endmacro %}